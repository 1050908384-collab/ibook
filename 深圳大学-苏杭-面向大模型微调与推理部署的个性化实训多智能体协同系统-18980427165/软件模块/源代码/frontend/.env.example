# When frontend and backend run on different hosts, set the backend LAN or
# production address here. Leave unset when both services share one host.
# VITE_API_BASE_URL=http://192.168.1.100:8500/api/v1

# Set to true to render the built-in UI preview without starting the backend.
# Set to false (or remove it) for API integration.
VITE_UI_PREVIEW=false
