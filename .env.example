APP_NAME=AI Agent Trainer
APP_HOST=0.0.0.0
APP_PORT=8500
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Local Ollama also serves as the automatic generation fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_FALLBACK_MODELS=deepseek-r1:7b,qwen2.5:7b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Put the API key created for the "AI-agent-teacher" project here.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_PROXY_URL=
DEEPSEEK_FALLBACK_IPS=
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=ollama

DATABASE_URL=sqlite:///../data/sqlite_data/project.db
CHROMA_PATH=../data/chroma_db
GRAPH_PATH=../data/graph_data/knowledge_graph.gpickle

LOG_LEVEL=INFO
DEBUG=false

MAX_REVIEW_ITERATIONS=3
CONFIDENCE_THRESHOLD=0.7
EXECUTION_MODE=hybrid
