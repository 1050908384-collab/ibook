# ============================================================
# AI Agent Trainer 后端环境变量模板
# 使用说明：
#   1. 复制本文件为 backend/.env（不要直接改本模板）
#   2. 根据本机环境修改值；注释里的默认值对应 config.py 中的兜底值
# ============================================================

# ---- 应用基础 ----
APP_NAME=AI Agent Trainer
# 默认：0.0.0.0（外网/局域网可访问）
APP_HOST=0.0.0.0
# 默认：8500；前端默认通过 hostname:8500 直连，改这个需同步前端 VITE_API_BASE_URL
APP_PORT=8500
# 允许的前端 Origin，逗号分隔；同时 main.py 有内网正则兜底，一般不用改
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---- LLM 提供方切换（默认使用云端 DeepSeek） ----
# deepseek = 调用云端 DeepSeek（推荐，配置 API Key 即可，无需本地 Ollama）
# ollama   = 走本地 Ollama（适合离线/隐私场景，需要先启动 ollama serve）
LLM_PROVIDER=deepseek
# 云端失败时是否回退本地 Ollama（ollama=回退到本地 deepseek-r1:7b；空字符串=不回退）
LLM_FALLBACK_PROVIDER=ollama

# ---- DeepSeek 云端（主提供方，默认启用）----
# 前往 https://platform.deepseek.com/ 创建 API Key 后粘贴到下面
# 注意：模板文件不要填写真实密钥；队友克隆仓库后请复制为 backend/.env 再填写自己的 key
DEEPSEEK_API_KEY=your-deepseek-api-key
# 官方地址 https://api.deepseek.com ；兼容其他 OpenAI 协议中转时可改
DEEPSEEK_API_BASE=https://api.deepseek.com
# 官方 API 模型标识：deepseek-chat；需要推理模型时可改为 deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
# 可选：本地代理地址。直连受限时填写，例如 http://127.0.0.1:7890。
DEEPSEEK_PROXY_URL=
# 单次云端请求读取超时与可恢复重试次数。长答疑/网络波动时用于避免空正文回退。
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_RETRIES=2

# ---- Ollama 本地模型（当 LLM_PROVIDER=ollama 或 FALLBACK=ollama 时启用） ----
# Ollama 服务地址（默认 ollama serve 端口）
OLLAMA_BASE_URL=http://localhost:11434
# （历史兼容别名 OLLMA_BASE_URL 也能识别，正式环境请用上面 OLLAMA_ 前缀）
# 本地首选模型。回退顺序由 OLLAMA_FALLBACK_MODELS 控制。
OLLAMA_MODEL=deepseek-r1:7b
# 本地模型按顺序回退：前一个无最终正文或请求失败才尝试下一个。
OLLAMA_FALLBACK_MODELS=deepseek-r1:7b,qwen2.5:7b
# 中文语义检索 embedding 模型（给 Agent3 技术问答做向量编码用）；切换后需重跑 scripts/init_knowledge_base.py
EMBEDDING_MODEL=qwen3-embedding:0.6b

# ---- 数据路径 ----
# SQLite 主库（相对 backend/ 目录）；唯一真相源
DATABASE_URL=sqlite:///../data/sqlite_data/project.db
# Chroma 向量库目录（相对 backend/ 目录）
CHROMA_PATH=../data/chroma_db
# NetworkX 知识图谱运行时文件（相对 backend/ 目录）
GRAPH_PATH=../data/graph_data/runtime/knowledge_graph.gpickle

# ---- 运行时 ----
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# uvicorn 热重载；生产用 false
DEBUG=false
# Agent3↔Agent4 最大审核辩论轮次；默认 3
MAX_REVIEW_ITERATIONS=3
# 画像盲区置信度阈值；默认 0.7
CONFIDENCE_THRESHOLD=0.7
# hybrid = 云端/本地 LLM + 确定性兜底（正常使用）
# deterministic = 纯确定性闭环，无需任何 LLM 也能跑通（调试/演示用）
EXECUTION_MODE=hybrid
# 块级并行流水线开关：true = Agent3/Agent4 按块并发（默认更快）；false = 旧整包顺序审核
BLOCK_PIPELINE_ENABLED=true
